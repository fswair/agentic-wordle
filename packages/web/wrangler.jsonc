{
  "name": "agentic-wordle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Cloudflare creates the DNS record and certificate for this hostname on deploy.
  "routes": [{ "pattern": "agentic-wordle.tomris.dev", "custom_domain": true }],
  // The answer lists are private and live outside the repo's tracked files.
  "alias": { "@words": "../../private/words/index.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, unknown paths (including /api/*) would be answered with index.html.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-wordle",
      "database_id": "706514dc-5e8c-4187-b9a3-63620b846f46",
      "migrations_dir": "migrations"
    }
  ]
}
